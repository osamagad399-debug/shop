{
  "name": "now-server",
  "version": "1.0.0",
  "description": "NOW Delivery API",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run prisma:migrate && node server.js",
    "start:railway": "bash start.sh",
    "start:prod": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node server/prisma/seed.js",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "test": "npm --prefix mobile test",
    "build": "npm run prisma:generate",
    "build:web": "npm --prefix mobile ci && npm --prefix mobile run build:web",
    "web": "npm --prefix mobile run web"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.9",
    "prisma": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
